# .env.example
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running
# docker-compose up.  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# ── LlamaParse ───────────────────────────────────────────────────────
# Cloud API key for LlamaParse PDF extraction (https://cloud.llamaindex.ai)
LLAMA_PARSE_API_KEY=your_llamaparse_api_key_here

# ── Ollama (runs on the HOST machine, not inside Docker) ─────────────
# On macOS/Windows use host.docker.internal so containers can reach the
# host network.  On Linux use the host's LAN IP or 172.17.0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434   # macOS/Windows: use this to reach Ollama on the host

# ── PostgreSQL ───────────────────────────────────────────────────────
# Full SQLAlchemy connection string — references the postgres service
# name so it resolves inside the compose network.
POSTGRES_DSN=postgresql://user:password@postgres:5432/mathdb

# Individual credentials used by the postgres service itself
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mathdb

# ── ChromaDB ─────────────────────────────────────────────────────────
# Service name resolves to the chromadb container inside compose network
CHROMA_HOST=chromadb
CHROMA_PORT=8000
